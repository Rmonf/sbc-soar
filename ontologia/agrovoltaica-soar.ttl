@prefix : <http://www.upc.edu/ontologies/agrovoltaica-soar/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.upc.edu/ontologies/agrovoltaica-soar/> .

<http://www.upc.edu/ontologies/agrovoltaica-soar> rdf:type owl:Ontology ;
                                                   rdfs:comment "Esquema de la memoria de trabajo del sistema CLIPS e individuos del conocimiento estático. No importa ontologías externas." ;
                                                   rdfs:label "Ontología agrovoltaica-SOAR (versión 3.0)" ;
                                                   owl:versionInfo "3.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.upc.edu/ontologies/agrovoltaica-soar/escrito-por
:escrito-por rdf:type owl:AnnotationProperty ;
             rdfs:comment "Quien puede crear/modifica el hecho" .


#################################################################
#    Object Properties
#################################################################

###  http://www.upc.edu/ontologies/agrovoltaica-soar/chunk-aplicado
:chunk-aplicado rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:range :Chunk ;
                rdfs:comment "Compartida: Preferencia (origen chunk) y Episodio (decisión tomada con un chunk). En el episodio es una referencia histórica: el chunk puede haberse olvidado después." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/en-estado
:en-estado rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:range :EstadoSOAR ;
           rdfs:comment "Compartida: Impasse, OperadorCandidato, Preferencia." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/estado-padre
:estado-padre rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :EstadoSOAR ;
              rdfs:range :EstadoSOAR .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/evalua-operador
:evalua-operador rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Valoracion ;
                 rdfs:range :OperadorCandidato .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/impasse-asociado
:impasse-asociado rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :EstadoSOAR ;
                  rdfs:range :Impasse .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/operador-comparado
:operador-comparado rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Preferencia ;
                    rdfs:range :OperadorCandidato ;
                    rdfs:comment "Solo en preferencias better." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/operador-referencia
:operador-referencia rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Preferencia ;
                     rdfs:range :OperadorCandidato .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/operadores-en-conflicto
:operadores-en-conflicto rdf:type owl:ObjectProperty ;
                         rdfs:domain :Impasse ;
                         rdfs:range :OperadorCandidato .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/sector
:sector rdf:type owl:ObjectProperty ,
                 owl:FunctionalProperty ;
        rdfs:range :Sector ;
        rdfs:comment "Compartida: observaciones, predicciones, abstracciones, diagnósticos, impasses, candidatos, preferencias, órdenes y episodios. Opcional solo en Prediccion (magnitudes globales)." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/tiene-cultivo
:tiene-cultivo rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Sector ;
               rdfs:range :Cultivo .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/tiene-seguidor
:tiene-seguidor rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Sector ;
                rdfs:range :SeguidorSolar .


#################################################################
#    Data properties
#################################################################

###  http://www.upc.edu/ontologies/agrovoltaica-soar/accion
:accion rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:range [ rdf:type rdfs:Datatype ;
                     owl:oneOf [ rdf:type rdf:List ;
                                 rdf:first "diagnosticar" ;
                                 rdf:rest [ rdf:type rdf:List ;
                                            rdf:first "mantenir-posicio" ;
                                            rdf:rest [ rdf:type rdf:List ;
                                                       rdf:first "orientar-ombra" ;
                                                       rdf:rest [ rdf:type rdf:List ;
                                                                  rdf:first "orientar-produccio" ;
                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                             rdf:first "posicio-seguretat" ;
                                                                             rdf:rest rdf:nil
                                                                           ]
                                                                ]
                                                     ]
                                          ]
                               ]
                   ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/accion-descartada
:accion-descartada rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Chunk ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:oneOf [ rdf:type rdf:List ;
                                            rdf:first "diagnosticar" ;
                                            rdf:rest [ rdf:type rdf:List ;
                                                       rdf:first "mantenir-posicio" ;
                                                       rdf:rest [ rdf:type rdf:List ;
                                                                  rdf:first "orientar-ombra" ;
                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                             rdf:first "orientar-produccio" ;
                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                        rdf:first "posicio-seguretat" ;
                                                                                        rdf:rest rdf:nil
                                                                                      ]
                                                                           ]
                                                                ]
                                                     ]
                                          ]
                              ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/accion-preferida
:accion-preferida rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Chunk ;
                  rdfs:range [ rdf:type rdfs:Datatype ;
                               owl:oneOf [ rdf:type rdf:List ;
                                           rdf:first "diagnosticar" ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first "mantenir-posicio" ;
                                                      rdf:rest [ rdf:type rdf:List ;
                                                                 rdf:first "orientar-ombra" ;
                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                            rdf:first "orientar-produccio" ;
                                                                            rdf:rest [ rdf:type rdf:List ;
                                                                                       rdf:first "posicio-seguretat" ;
                                                                                       rdf:rest rdf:nil
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ]
                             ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/alternativas
:alternativas rdf:type owl:DatatypeProperty ;
              rdfs:domain :Episodio ;
              rdfs:range [ rdf:type rdfs:Datatype ;
                           owl:oneOf [ rdf:type rdf:List ;
                                       rdf:first "diagnosticar" ;
                                       rdf:rest [ rdf:type rdf:List ;
                                                  rdf:first "mantenir-posicio" ;
                                                  rdf:rest [ rdf:type rdf:List ;
                                                             rdf:first "orientar-ombra" ;
                                                             rdf:rest [ rdf:type rdf:List ;
                                                                        rdf:first "orientar-produccio" ;
                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                   rdf:first "posicio-seguretat" ;
                                                                                   rdf:rest rdf:nil
                                                                                 ]
                                                                      ]
                                                           ]
                                                ]
                                     ]
                         ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/angulo-actual
:angulo-actual rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :ObservacionPanel ;
               rdfs:range xsd:decimal .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/angulo-defensa-viento
:angulo-defensa-viento rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :SeguidorSolar ;
                       rdfs:range xsd:decimal .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/angulo-maximo
:angulo-maximo rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :SeguidorSolar ;
               rdfs:range xsd:decimal .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/angulo-minimo
:angulo-minimo rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :SeguidorSolar ;
               rdfs:range xsd:decimal .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/angulo-objetivo
:angulo-objetivo rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :OperadorCandidato ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "Ausente (nil) solo en acciones sin movimiento cuando falta la observación de panel." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/angulo-ordenado
:angulo-ordenado rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "Compartida: OrdenActuador y Episodio. Ausente (nil) = mantener sin mover cuando el ángulo actual es desconocido." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/angulo-previo
:angulo-previo rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Episodio ;
               rdfs:range xsd:decimal ;
               rdfs:comment "Ángulo medido al decidir. Hubo movimiento si |angulo-ordenado - angulo-previo| > tolerancia-angulo (R4). Ausente si faltaba la observación de panel." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/aprendizaje-activo
:aprendizaje-activo rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :ParametrosAprendizaje ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "FALSE = línea base sin aprendizaje: APRENENTATGE no crea, refuerza ni olvida chunks." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/beneficio-cultivo
:beneficio-cultivo rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:oneOf [ rdf:type rdf:List ;
                                            rdf:first "alt" ;
                                            rdf:rest [ rdf:type rdf:List ;
                                                       rdf:first "baix" ;
                                                       rdf:rest [ rdf:type rdf:List ;
                                                                  rdf:first "critic" ;
                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                             rdf:first "mitja" ;
                                                                             rdf:rest rdf:nil
                                                                           ]
                                                                ]
                                                     ]
                                          ]
                              ] ;
                   rdfs:comment "Compartida: Valoracion (del candidato) y Episodio (de la acción elegida; vista agronómica)." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/beneficio-descartada
:beneficio-descartada rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Chunk ;
                      rdfs:range [ rdf:type rdfs:Datatype ;
                                   owl:oneOf [ rdf:type rdf:List ;
                                               rdf:first "alt" ;
                                               rdf:rest [ rdf:type rdf:List ;
                                                          rdf:first "baix" ;
                                                          rdf:rest [ rdf:type rdf:List ;
                                                                     rdf:first "critic" ;
                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                rdf:first "mitja" ;
                                                                                rdf:rest rdf:nil
                                                                              ]
                                                                   ]
                                                        ]
                                             ]
                                 ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/beneficio-energia
:beneficio-energia rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:oneOf [ rdf:type rdf:List ;
                                            rdf:first "alt" ;
                                            rdf:rest [ rdf:type rdf:List ;
                                                       rdf:first "baix" ;
                                                       rdf:rest [ rdf:type rdf:List ;
                                                                  rdf:first "critic" ;
                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                             rdf:first "mitja" ;
                                                                             rdf:rest rdf:nil
                                                                           ]
                                                                ]
                                                     ]
                                          ]
                              ] ;
                   rdfs:comment "Compartida: Valoracion (del candidato) y Episodio (de la acción elegida; vista energética)." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/beneficio-mecanico
:beneficio-mecanico rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Valoracion ;
                    rdfs:range [ rdf:type rdfs:Datatype ;
                                 owl:oneOf [ rdf:type rdf:List ;
                                             rdf:first "alt" ;
                                             rdf:rest [ rdf:type rdf:List ;
                                                        rdf:first "baix" ;
                                                        rdf:rest [ rdf:type rdf:List ;
                                                                   rdf:first "critic" ;
                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                              rdf:first "mitja" ;
                                                                              rdf:rest rdf:nil
                                                                            ]
                                                                 ]
                                                      ]
                                           ]
                               ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/beneficio-preferida
:beneficio-preferida rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Chunk ;
                     rdfs:range [ rdf:type rdfs:Datatype ;
                                  owl:oneOf [ rdf:type rdf:List ;
                                              rdf:first "alt" ;
                                              rdf:rest [ rdf:type rdf:List ;
                                                         rdf:first "baix" ;
                                                         rdf:rest [ rdf:type rdf:List ;
                                                                    rdf:first "critic" ;
                                                                    rdf:rest [ rdf:type rdf:List ;
                                                                               rdf:first "mitja" ;
                                                                               rdf:rest rdf:nil
                                                                             ]
                                                                  ]
                                                       ]
                                            ]
                                ] ;
                     rdfs:comment "Mayor de los tres beneficios de la acción preferida. Como cada acción solo tiene beneficio en su propio criterio, la acción y este nivel determinan su valoración completa." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/calidad
:calidad rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :ObservacionSensor ;
         rdfs:range [ rdf:type rdfs:Datatype ;
                      owl:oneOf [ rdf:type rdf:List ;
                                  rdf:first "degradat" ;
                                  rdf:rest [ rdf:type rdf:List ;
                                             rdf:first "fallada" ;
                                             rdf:rest [ rdf:type rdf:List ;
                                                        rdf:first "ok" ;
                                                        rdf:rest rdf:nil
                                                      ]
                                           ]
                                ]
                    ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/coste-movimiento
:coste-movimiento rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Valoracion ;
                  rdfs:range [ rdf:type rdfs:Datatype ;
                               owl:oneOf [ rdf:type rdf:List ;
                                           rdf:first "alt" ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first "baix" ;
                                                      rdf:rest [ rdf:type rdf:List ;
                                                                 rdf:first "critic" ;
                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                            rdf:first "mitja" ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ]
                             ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/criterio
:criterio rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:range [ rdf:type rdfs:Datatype ;
                       owl:oneOf [ rdf:type rdf:List ;
                                   rdf:first "estabilitat" ;
                                   rdf:rest [ rdf:type rdf:List ;
                                              rdf:first "integritat-mecanica" ;
                                              rdf:rest [ rdf:type rdf:List ;
                                                         rdf:first "produccio-energia" ;
                                                         rdf:rest [ rdf:type rdf:List ;
                                                                    rdf:first "proteccio-cultiu" ;
                                                                    rdf:rest [ rdf:type rdf:List ;
                                                                               rdf:first "seguretat-persones" ;
                                                                               rdf:rest rdf:nil
                                                                             ]
                                                                  ]
                                                       ]
                                            ]
                                 ]
                     ] ;
          rdfs:comment "Compartida: Preferencia (objetivo que la justifica) y Chunk (criterio de la preferencia aprendida). Estabilidad y mínima intervención: estabilitat. R1 y R5: seguretat-persones. R2, R3 y R4: integritat-mecanica. require de dades-insuficients: integritat-mecanica. constraint-failure: el criterio de mayor prioridad entre los reject del sector (integritat-mecanica si no hay). Acción útil y prioritat-objectius: el objetivo de mayor prioridad servido." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/criterio-determinante
:criterio-determinante rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :Episodio ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Criterio del require, del better decisivo o del chunk (NombreObjetivo), o estrategia del impasse (EstrategiaResolucion)." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/descartes
:descartes rdf:type owl:DatatypeProperty ;
           rdfs:domain :Episodio ;
           rdfs:range xsd:string ;
           rdfs:comment "accion:criterio de cada candidato descartado (rechazado o dominado)." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/desplazamiento
:desplazamiento rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Valoracion ;
                rdfs:range xsd:decimal ;
                rdfs:comment "Delta = |angulo-objetivo - angulo-actual| en grados; 0 en las acciones sin movimiento." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/escalado-humano
:escalado-humano rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:range xsd:boolean .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/estado-candidato
:estado-candidato rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :OperadorCandidato ;
                  rdfs:range [ rdf:type rdfs:Datatype ;
                               owl:oneOf [ rdf:type rdf:List ;
                                           rdf:first "aplicat" ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first "candidat" ;
                                                      rdf:rest [ rdf:type rdf:List ;
                                                                 rdf:first "descartat" ;
                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                            rdf:first "seleccionat" ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ]
                             ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/estado-mecanico
:estado-mecanico rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :ObservacionPanel ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:oneOf [ rdf:type rdf:List ;
                                          rdf:first "alarma" ;
                                          rdf:rest [ rdf:type rdf:List ;
                                                     rdf:first "bloquejat" ;
                                                     rdf:rest [ rdf:type rdf:List ;
                                                                rdf:first "operatiu" ;
                                                                rdf:rest rdf:nil
                                                              ]
                                                   ]
                                        ]
                            ] .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/estrategia-resolucion
:estrategia-resolucion rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:range [ rdf:type rdfs:Datatype ;
                                    owl:oneOf [ rdf:type rdf:List ;
                                                rdf:first "demanar-dades" ;
                                                rdf:rest [ rdf:type rdf:List ;
                                                           rdf:first "escalat" ;
                                                           rdf:rest [ rdf:type rdf:List ;
                                                                      rdf:first "minima-intervencio" ;
                                                                      rdf:rest [ rdf:type rdf:List ;
                                                                                 rdf:first "posicio-preventiva" ;
                                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                                            rdf:first "prioritat-objectius" ;
                                                                                            rdf:rest [ rdf:type rdf:List ;
                                                                                                       rdf:first "restriccio-prioritaria" ;
                                                                                                       rdf:rest rdf:nil
                                                                                                     ]
                                                                                          ]
                                                                               ]
                                                                    ]
                                                         ]
                                              ]
                                  ] ;
                       rdfs:comment "Compartida: Impasse (estrategia que lo resolvió; ausente mientras está abierto) y Chunk (estrategia de la que se aprendió)." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/evidencias
:evidencias rdf:type owl:DatatypeProperty ;
            rdfs:domain :Diagnostico ;
            rdfs:range xsd:string ;
            rdfs:comment "Variables y niveles que sustentan el diagnóstico (p. ej. \"vent:critic\", \"observacio-panel:absent\", \"moviment-no-ordenat\")." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/fase
:fase rdf:type owl:DatatypeProperty ,
               owl:FunctionalProperty ;
      rdfs:range [ rdf:type rdfs:Datatype ;
                   owl:oneOf [ rdf:type rdf:List ;
                               rdf:first "aplicacio" ;
                               rdf:rest [ rdf:type rdf:List ;
                                          rdf:first "aprenentatge" ;
                                          rdf:rest [ rdf:type rdf:List ;
                                                     rdf:first "avaluacio" ;
                                                     rdf:rest [ rdf:type rdf:List ;
                                                                rdf:first "deliberacio" ;
                                                                rdf:rest [ rdf:type rdf:List ;
                                                                           rdf:first "elaboracio" ;
                                                                           rdf:rest [ rdf:type rdf:List ;
                                                                                      rdf:first "espera" ;
                                                                                      rdf:rest [ rdf:type rdf:List ;
                                                                                                 rdf:first "explicacio" ;
                                                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                                                            rdf:first "monitoratge" ;
                                                                                                            rdf:rest [ rdf:type rdf:List ;
                                                                                                                       rdf:first "neteja" ;
                                                                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                                                                  rdf:first "percepcio" ;
                                                                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                                                                             rdf:first "proposta" ;
                                                                                                                                             rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                        rdf:first "seleccio" ;
                                                                                                                                                        rdf:rest rdf:nil
                                                                                                                                                      ]
                                                                                                                                           ]
                                                                                                                                ]
                                                                                                                     ]
                                                                                                          ]
                                                                                               ]
                                                                                    ]
                                                                         ]
                                                              ]
                                                   ]
                                        ]
                             ]
                 ] ;
      rdfs:comment "Compartida: EstadoSOAR y DefinicionFase." .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/fase-fenologica
:fase-fenologica rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Cultivo ;
                 rdfs:range xsd:string .


###  http://www.upc.edu/ontologies/agrovoltaica-soar/id
:id rdf:type owl:DatatypeProperty ,
             owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "En los individuos de este fichero el id es el nombre local." .


