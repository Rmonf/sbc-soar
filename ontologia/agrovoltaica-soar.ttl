#    Individuals
#################################################################

###  http://www.upc.edu/ontologies/agrovoltaica-soar/S0
:S0 rdf:type owl:NamedIndividual ,
             :EstadoSOAR ;
    :fase "espera" ;
    :subfase "pendent" .


