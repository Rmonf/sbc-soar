;;; base_coneixement.clp: GENERADO por python/ontologia.py a partir de ontologia/agrovoltaica-soar.ttl.
;;; No se edita a mano: si cambia el TTL, se regenera (roadmap §2.2).

(deffacts MAIN::base-coneixement
   ;; sector
   (sector (id s1) (tiene-cultivo cultivo-s1) (tiene-seguidor seguidor-s1))
   (sector (id s2) (tiene-cultivo cultivo-s2) (tiene-seguidor seguidor-s2))
   (sector (id s3) (tiene-cultivo cultivo-s3) (tiene-seguidor seguidor-s3))
   ;; cultivo
   (cultivo (id cultivo-s1) (nombre-cultivo tomate) (fase-fenologica floracion) (sensibilidad alt) (umbral-temp-estres 30.0) (umbral-humedad-critica 45.0))
   (cultivo (id cultivo-s2) (nombre-cultivo lechuga) (fase-fenologica desarrollo) (sensibilidad critic) (umbral-temp-estres 26.0) (umbral-humedad-critica 55.0))
   (cultivo (id cultivo-s3) (nombre-cultivo vina) (fase-fenologica maduracion) (sensibilidad mitja) (umbral-temp-estres 35.0) (umbral-humedad-critica 30.0))
   ;; seguidor-solar
   (seguidor-solar (id seguidor-s1) (angulo-minimo -60.0) (angulo-maximo 60.0) (angulo-defensa-viento 0.0) (umbral-viento-critico 70.0) (max-movimientos-hora 4) (tolerancia-angulo 2.0))
   (seguidor-solar (id seguidor-s2) (angulo-minimo -60.0) (angulo-maximo 60.0) (angulo-defensa-viento 0.0) (umbral-viento-critico 70.0) (max-movimientos-hora 4) (tolerancia-angulo 2.0))
   (seguidor-solar (id seguidor-s3) (angulo-minimo -60.0) (angulo-maximo 60.0) (angulo-defensa-viento 0.0) (umbral-viento-critico 70.0) (max-movimientos-hora 4) (tolerancia-angulo 2.0))
   ;; objetivo-activo
   (objetivo-activo (nombre-objetivo estabilitat) (prioridad 5) (tipo-restriccion tova))
   (objetivo-activo (nombre-objetivo integritat-mecanica) (prioridad 2) (tipo-restriccion dura))
   (objetivo-activo (nombre-objetivo produccio-energia) (prioridad 4) (tipo-restriccion tova))
   (objetivo-activo (nombre-objetivo proteccio-cultiu) (prioridad 3) (tipo-restriccion tova))
   (objetivo-activo (nombre-objetivo seguretat-persones) (prioridad 1) (tipo-restriccion dura))
   ;; dato-requerido
   (dato-requerido (variable humitat-sol) (nivel alt))
   (dato-requerido (variable radiacio) (nivel alt))
   (dato-requerido (variable temp-cultiu) (nivel alt))
   (dato-requerido (variable vent) (nivel critic))
   ;; definicion-fase
   (definicion-fase (fase aplicacio) (modulo APLICACIO) (siguiente explicacio))
   (definicion-fase (fase aprenentatge) (modulo APRENENTATGE) (siguiente neteja))
   (definicion-fase (fase avaluacio) (modulo AVALUACIO) (siguiente seleccio))
   (definicion-fase (fase deliberacio) (modulo DELIBERACIO) (siguiente seleccio))
   (definicion-fase (fase elaboracio) (modulo ELABORACIO) (siguiente proposta))
   (definicion-fase (fase explicacio) (modulo EXPLICACIO) (siguiente aprenentatge))
   (definicion-fase (fase monitoratge) (modulo MONITORATGE) (siguiente elaboracio))
   (definicion-fase (fase neteja) (modulo NETEJA) (siguiente espera))
   (definicion-fase (fase percepcio) (modulo PERCEPCIO) (siguiente monitoratge))
   (definicion-fase (fase proposta) (modulo PROPOSTA) (siguiente avaluacio))
   (definicion-fase (fase seleccio) (modulo SELECCIO) (siguiente aplicacio))
   ;; umbral
   (umbral (variable humitat-sol) (nivel alt) (limite-inferior -10.0) (limite-superior 0.0) (referencia cultiu))
   (umbral (variable humitat-sol) (nivel baix) (limite-inferior 10.0) (referencia cultiu))
   (umbral (variable humitat-sol) (nivel critic) (limite-superior -10.0) (referencia cultiu))
   (umbral (variable humitat-sol) (nivel mitja) (limite-inferior 0.0) (limite-superior 10.0) (referencia cultiu))
   (umbral (variable moviment) (nivel alt) (limite-inferior 20.0) (referencia absoluta))
   (umbral (variable moviment) (nivel baix) (limite-superior 5.0) (referencia absoluta))
   (umbral (variable moviment) (nivel mitja) (limite-inferior 5.0) (limite-superior 20.0) (referencia absoluta))
   (umbral (variable pluja) (nivel alt) (limite-inferior 2.0) (limite-superior 10.0) (referencia absoluta))
   (umbral (variable pluja) (nivel baix) (limite-superior 0.5) (referencia absoluta))
   (umbral (variable pluja) (nivel critic) (limite-inferior 10.0) (referencia absoluta))
   (umbral (variable pluja) (nivel mitja) (limite-inferior 0.5) (limite-superior 2.0) (referencia absoluta))
   (umbral (variable pluja-prevista) (nivel alt) (limite-inferior 2.0) (limite-superior 10.0) (referencia absoluta))
   (umbral (variable pluja-prevista) (nivel baix) (limite-superior 0.5) (referencia absoluta))
   (umbral (variable pluja-prevista) (nivel critic) (limite-inferior 10.0) (referencia absoluta))
   (umbral (variable pluja-prevista) (nivel mitja) (limite-inferior 0.5) (limite-superior 2.0) (referencia absoluta))
   (umbral (variable preu-energia) (nivel alt) (limite-inferior 100.0) (limite-superior 180.0) (referencia absoluta))
   (umbral (variable preu-energia) (nivel baix) (limite-superior 50.0) (referencia absoluta))
   (umbral (variable preu-energia) (nivel critic) (limite-inferior 180.0) (referencia absoluta))
   (umbral (variable preu-energia) (nivel mitja) (limite-inferior 50.0) (limite-superior 100.0) (referencia absoluta))
   (umbral (variable radiacio) (nivel alt) (limite-inferior 500.0) (limite-superior 800.0) (referencia absoluta))
   (umbral (variable radiacio) (nivel baix) (limite-superior 200.0) (referencia absoluta))
   (umbral (variable radiacio) (nivel critic) (limite-inferior 800.0) (referencia absoluta))
   (umbral (variable radiacio) (nivel mitja) (limite-inferior 200.0) (limite-superior 500.0) (referencia absoluta))
   (umbral (variable temp-cultiu) (nivel alt) (limite-inferior 0.0) (limite-superior 4.0) (referencia cultiu))
   (umbral (variable temp-cultiu) (nivel baix) (limite-superior -3.0) (referencia cultiu))
   (umbral (variable temp-cultiu) (nivel critic) (limite-inferior 4.0) (referencia cultiu))
   (umbral (variable temp-cultiu) (nivel mitja) (limite-inferior -3.0) (limite-superior 0.0) (referencia cultiu))
   (umbral (variable vent) (nivel alt) (limite-inferior -20.0) (limite-superior 0.0) (referencia seguidor))
   (umbral (variable vent) (nivel baix) (limite-superior -40.0) (referencia seguidor))
   (umbral (variable vent) (nivel critic) (limite-inferior 0.0) (referencia seguidor))
   (umbral (variable vent) (nivel mitja) (limite-inferior -40.0) (limite-superior -20.0) (referencia seguidor))
   (umbral (variable vent-previst) (nivel alt) (limite-inferior -20.0) (limite-superior 0.0) (referencia seguidor))
   (umbral (variable vent-previst) (nivel baix) (limite-superior -40.0) (referencia seguidor))
   (umbral (variable vent-previst) (nivel critic) (limite-inferior 0.0) (referencia seguidor))
   (umbral (variable vent-previst) (nivel mitja) (limite-inferior -40.0) (limite-superior -20.0) (referencia seguidor))
   ;; parametros-aprendizaje
   (parametros-aprendizaje (aprendizaje-activo TRUE) (tasa-decaimiento 0.5) (umbral-olvido -2.0) (max-referencias 10))
   ;; estado-soar
   (estado-soar (id S0) (fase espera) (subfase pendent))
)
